function Icon({ name, size = 18, stroke = 1.75, color = 'currentColor', label }) {
  const nodes = ICONS[name] || ICONS['circle-help'];
  return (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke={color} strokeWidth={stroke} strokeLinecap="round" strokeLinejoin="round"
      aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label} data-lucide={name} style={{ flex: `0 0 ${size}px`, display: 'block' }}>
      {nodes.map(([t, a], i) => React.createElement(t, { key: i, ...a }))}
    </svg>
  );
}


// Roles & permissions (documents/roles-and-permissions.md). access: act | reason | approve | disabled | read | hidden
// Roles that REACH this build (Sales Floor is in their NavConfig nav). Outfitters don't: they use Outfitter Mobile.
const ROLES = { manager: 'Sales manager', receptionist: 'Receptionist' };
const PERMS = {
  'case.create':      { manager: 'act',    receptionist: 'act',      outfitter: 'hidden' },
  'case.assign':      { manager: 'act',    receptionist: 'act',      outfitter: 'hidden' },
  'case.override':    { manager: 'reason', receptionist: 'reason',   outfitter: 'hidden' },
  'case.move':        { manager: 'act',    receptionist: 'read',     outfitter: 'hidden' },
  'case.note':        { manager: 'act',    receptionist: 'act',      outfitter: 'hidden' },
  'case.close':       { manager: 'reason', receptionist: 'reason',   outfitter: 'hidden' },
  'case.view_detail': { manager: 'act',    receptionist: 'act',      outfitter: 'hidden' },
  'rep.message':      { manager: 'act',    receptionist: 'act',      outfitter: 'hidden' },
  'rep.pause':        { manager: 'reason', receptionist: 'approve',  outfitter: 'hidden' },
  'rep.bench':        { manager: 'reason', receptionist: 'disabled', outfitter: 'hidden' },
  'rep.stats':        { manager: 'act',    receptionist: 'hidden',   outfitter: 'hidden' },
  'rotation.reorder': { manager: 'reason', receptionist: 'hidden',   outfitter: 'hidden' },
  'rotation.view':    { manager: 'act',    receptionist: 'act',      outfitter: 'hidden' },
  'schedule.checkin': { manager: 'act',    receptionist: 'act',      outfitter: 'hidden' },
  'phase.stats':      { manager: 'act',    receptionist: 'read',     outfitter: 'hidden' },
};
const can = (role, perm) => (PERMS[perm] && PERMS[perm][role]) || 'hidden';
const shows = (role, perm) => can(role, perm) !== 'hidden';
const acts = (role, perm) => ['act', 'reason', 'approve'].includes(can(role, perm));
window.FW = { ROLES, PERMS, can, shows, acts,  PHASES, OUTFITTERS, OUTFITTER_BY_ID, ROTATION, REP_STATE, SEED_CARDS, SEED_EXITS, SCHEDULE, LEFT_REASONS, PAUSE_REASONS, BENCH_REASONS, BENCH_DURATIONS, MOVE_REP_REASONS, OVERRIDE_REASONS, UNIT_TYPES, PARTY_TYPES, REP_STATS, CHAT, Icon };
})();
