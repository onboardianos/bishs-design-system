const KEY = 'fw-links-urls';
const saved = () => { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) { return {}; } };
const applySaved = () => { const s = saved(); LINKS.forEach((x) => { if (s[x.id]) { x.url = s[x.id].url; x.embed = embedFor(x.url, s[x.id].embed); } }); };
applySaved();
function setUrl(id, url, embed = 'iframe') { const s = saved(); s[id] = { url, embed }; localStorage.setItem(KEY, JSON.stringify(s)); applySaved(); }
function exportList() { return LINKS.filter((x) => x.url).map((x) => `${x.id} | ${x.title} | ${x.url}`).join('\n'); }
const norm = (s) => String(s || '').toLowerCase().replace(/[·—–:&()§]/g, ' ');
function search(q) {
  const t = norm(q).trim();
  if (!t) return [];
  const words = t.split(/\s+/).filter(Boolean);
  return LINKS.map((l) => {
    const title = norm(l.title), hay = `${title} ${norm(l.keywords)} ${norm(l.group)}`;
    const hits = words.filter((w) => hay.includes(w)).length;
    if (hits < words.length) return null;
    return { ...l, score: hits + (title.startsWith(t) ? 3 : 0) + (title.includes(t) ? 1 : 0) };
  }).filter(Boolean).sort((a, b) => b.score - a.score || a.title.localeCompare(b.title)).slice(0, 20);
}
window.FW_LINKS = { LINKS, search, setUrl, exportList, embedFor };
})();
