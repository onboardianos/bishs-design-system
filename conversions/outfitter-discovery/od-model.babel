    { id: 'bedroom', nav: 'Bedroom', title: 'For the adults, how much does bedroom privacy matter?', sub: 'A door-separated bedroom can eliminate compact layouts. Flexible privacy keeps more inventory alive.', effect: 'Hard gate on Private Master, or a preference', trace: 'Q008 + Q009',
      skip: (S, c) => { if (isB(S)) return 'Class B has no separate bedroom'; const sh = c.share([I.PRIVATE_MASTER]); if (sh >= 0.95) return 'Nearly every unit has one'; if (sh <= 0.05) return 'Almost none have one'; return null; },
      single: (S, c) => (S.path === 'MOTOR' ? [O.pmMust, O.pmPref, O.anyBed] : [O.pmMust, O.pmPref, O.openSpace, O.anyBed].filter((o) => o.kind !== 'rank' || c.splits(o))),
      get: (S) => S.bedroom, set: (S, v) => reset(S, { bedroom: v }), ok: (S) => !!S.bedroom,
      warn: (S) => (S.path === 'MOTOR' ? { tone: 'info', title: 'Motorhome branch.', text: '"Prefer open daytime space" is not offered here: it keys on rear-living and front-living layouts, and no motorhome in stock carries either tag. The fold-away bed choice is on the Inside step instead, where it splits the vans.' } : null) },
    { id: 'length', nav: 'Length', title: 'Is there a hard length limit?', sub: 'Storage spots, driveways and campsites often set one. Only a hard limit asks for a number.', effect: 'Hard gate on length, or shorter-is-better priority', trace: 'Q010',
      single: (S) => [{ id: 'hard', title: 'Hard limit', icon: 'arrow-left-right', kind: 'gate', patch: { lengthMaxFt: Number(S.lengthFt) > 0 ? Math.floor(Number(S.lengthFt)) : null }, ben: ['Longer units are removed', 'Enter whole feet', 'Unknown lengths move to "needs verification"'] }, { id: 'soft', title: 'Shorter is better', icon: 'arrow-left-right', kind: 'prio', priority: 'compact', ben: ['Nothing removed', 'Shorter units earn up to 3 points', 'No number needed'] }, { id: 'none', title: 'Not a concern', icon: 'circle', kind: 'open', ben: ['Every length stays in play', 'Filter by length in results', 'Most common answer'] }],
      get: (S) => S.lengthMode, set: (S, v) => reset(S, { lengthMode: v }), ok: () => true, panel: (S) => (S.lengthMode === 'hard' ? 'length' : null),
      warn: (S, c) => { const r = c.pool.map((u) => u.lengthIn).filter((v) => v != null); if (!r.length) return null; return { tone: 'neutral', title: 'In play right now:', text: `${Math.round(Math.min(...r) / 12)}–${Math.round(Math.max(...r) / 12)} ft${c.pool.length - r.length > 0 ? `, with ${n(c.pool.length - r.length)} units missing a length` : ''}.` }; } },
    { id: 'garage', nav: 'Garage', title: 'How long does the garage need to be?', sub: 'Measure the longest toy. Shorter garages are removed.', effect: 'Hard gate on garage length (live-build gate, applied as a pre-filter here)', trace: 'Q010B', skip: (S) => (!TOY.includes(S.type) ? 'Toy haulers only' : null),
      single: () => [{ id: 'need', title: 'They know the length', icon: 'warehouse', kind: 'open', ben: ['Enter feet', 'Shorter garages are removed', 'Unknown garages stay in'] }, { id: 'any', title: 'Any garage is fine', icon: 'circle', kind: 'open', ben: ['No gate', 'Garage length shows on every result', 'Sort by it in results'] }],
      get: (S) => (S.garageFt === 'any' ? 'any' : S.garageFt !== '' ? 'need' : null), set: (S, v) => reset(S, { garageFt: v === 'any' ? 'any' : '0' }), ok: () => true, panel: (S) => (S.garageFt !== 'any' && S.garageFt !== '' ? 'garage' : null) },
    { id: 'bath', nav: 'Bathroom', title: 'What matters in the bathroom and getting in and out?', sub: 'Select all that apply. Mark a card as required to remove units without it.', multi: 'bath', effect: 'Ranking preferences · required cards become hard gates', trace: 'Q011 + Q012', skip: (S, c) => (c.multiOpts('bath').length <= 1 ? 'Nothing left to split' : null) },
    { id: 'inside', nav: 'Inside', title: 'How will they live inside?', sub: 'Select all that apply. Only features that split the units still in play are shown.', multi: 'inside', effect: 'Ranking preferences · required cards become hard gates', trace: 'Q013 + Q015 + Q018 extras', skip: (S, c) => (c.multiOpts('inside').length <= 1 ? 'Nothing left to split' : null) },
    { id: 'outside', nav: 'Outside', title: 'How will they live outside?', sub: 'Select all that apply.', multi: 'outside', effect: 'Ranking preferences · required cards become hard gates', trace: 'Q014 + Q018 toy hauler', skip: (S, c) => (c.multiOpts('outside').length <= 1 ? (S.path === 'MOTOR' ? 'No outside features in motorhome stock' : 'Nothing left to split') : null) },
    { id: 'size', nav: 'Size & build', title: 'More room, or easier to handle?', sub: 'Ranking only. Filters after results handle exact slide counts.', effect: 'Ranking priorities · construction preference · optional construction gate', trace: 'Q016 + Q017', skip: (S, c) => (new Set(c.pool.map((u) => u.slides).filter((v) => v != null)).size <= 1 ? 'Slide counts do not vary' : null),
      single: () => [O.space, O.balanced, O.simple], get: (S) => S.size, set: (S, v) => reset(S, { size: v }), ok: (S) => !!S.size, panel: () => 'build' },
    { id: 'results', nav: 'Matches', title: 'Matches', results: true },
  ];
  const txt = (v, S) => (typeof v === 'function' ? v(S) : v);
  const visible = (S, c) => SCREENS.filter((s) => !(s.skip && s.skip(S, c)));
  function summary(s, S, c) {
    if (s.multi) { const sel = S[s.multi]; if (!sel.length) return 'Open / no preference'; const names = Object.fromEntries(c.multiOpts(s.multi).map((o) => [o.id, o.title])); return sel.map((id) => (names[id] || id) + (S[s.multi + 'Must'].includes(id) ? ' (required)' : '')).join(' · '); }
    const v = s.get && s.get(S); let t = v ? ((s.single(S, c).find((o) => o.id === v) || {}).title || v) : 'Nothing yet';
    if (s.id === 'sleep') t = `${S.adults} adults · ${S.children} children` + (S.childSetup ? ' · ' + t : '');
    if (s.id === 'length' && S.lengthMode === 'hard' && S.lengthFt) t += ' · under ' + S.lengthFt + ' ft';
    if (s.id === 'size' && S.build) t += ' · ' + (O[S.build] || {}).title + (S.buildMust ? ' (required)' : '');
    return t;
  }
  function toggle(S, key, id) {
    const sel = S[key].slice(), must = S[key + 'Must'].slice();
    if (id === 'open') return reset(S, { [key]: [], [key + 'Must']: [] });
    const i = sel.indexOf(id);
    if (i >= 0) { sel.splice(i, 1); const j = must.indexOf(id); if (j >= 0) must.splice(j, 1); } else sel.push(id);
    return reset(S, { [key]: sel, [key + 'Must']: must });
  }
  function toggleMust(S, key, id, on) { const must = S[key + 'Must'].filter((x) => x !== id); if (on) must.push(id); return reset(S, { [key + 'Must']: must }); }
  // Zero-result recovery (engine s16) → which step set the gate, so the outfitter can go back and change it.
  const GATE_STEP = { gvwrMax: 'tow', lengthMaxFt: 'length', priceMax: 'budget', sleepsMin: 'sleep', slidesMin: 'size', bunks: 'sleep', requiredAnyOf: 'sleep', privateMaster: 'bedroom', outsideKitchen: 'outside', sidewall: 'size', classes: 'type', requiredChars: 'inside' };
  const KIND = { gate: 'Removes units that don’t match.', rank: 'Ranks matching units higher.', avoid: 'Ranks matching units lower.', prio: 'Re-orders by a measured value.', sidewall: 'Ranks one construction higher.', open: 'No effect on ranking.' };
  return { E, snap, UNITS, O, SCREENS, stores, compute, visible, summary, toggle, toggleMust, txt, unitsNow, GATE_STEP, KIND, n };
}

const INITIAL = { path: null, type: null, motor: null, budget: null, maxSpend: '', payment: '', down: '', tier: 'good', store: '', tow: null, towRating: '', towMode: 'derived', adults: 2, children: 0, childSetup: null, bedroom: null, lengthMode: 'none', lengthFt: '', garageFt: '', bath: [], bathMust: [], inside: [], insideMust: [], outside: [], outsideMust: [], size: null, build: null, buildMust: false };

// Snapshot loader: fetch the columnar JSON once and rebuild the source's unit objects.
let loading = null;
function decode(j) {
  const C = j.cols;
  const units = j.rows.map((r) => { const o = {}; for (let i = 0; i < C.length; i++) { let v = r[i]; if (v === undefined) v = null; if (C[i] === 'isLStock') v = !!v; if ((C[i] === 'characteristicTypeIds' || C[i] === 'qaFlags') && v == null) v = []; o[C[i]] = v; } return o; });
  window.BISH_SNAPSHOT = { meta: j.meta, lookups: j.lookups, units };
  return window.BISH_SNAPSHOT;
}
// The snapshot ships as data/snapshot.jsonp (a script tag), so it also works inside the offline single-file build.
function loadSnapshot() {
  if (window.BISH_SNAPSHOT) return Promise.resolve(window.BISH_SNAPSHOT);
  if (window.OD_SNAPSHOT_JSON) { try { return Promise.resolve(decode(window.OD_SNAPSHOT_JSON)); } catch (e) { return Promise.reject(e); } }
  if (!loading) loading = fetch('data/snapshot.json').then((r) => { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); }).then(decode).catch((e) => { loading = null; throw e; });
  return loading;
}
let model = null;
const getModel = (snap) => model || (model = createModel(snap));
window.OD = { INITIAL, loadSnapshot, getModel };
})();
